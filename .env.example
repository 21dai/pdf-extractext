# Application Settings
APP_NAME=PDF Extract API
APP_VERSION=0.1.0
DEBUG=False
APP_API_KEY=dev-api-key

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=mongodb://admin:9009@localhost:27017/?authSource=admin
DATABASE_NAME=pdf_extract
DATABASE_TIMEOUT_MS=3000
MAX_PDF_SIZE_BYTES=10485760

# Ollama Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_SUMMARY_MAX_CHARS=12000

# API Settings
API_V1_PREFIX=/api/v1
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json

# MongoDB Docker Credentials
ROOT_USERNAME=admin
ROOT_PASSWORD=9009
