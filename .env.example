# Application Settings
APP_NAME=PDF Extract API
APP_VERSION=2.0.0
DEBUG=False
# Nivel de los logs JSON en stdout: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Tag inmutable de la imagen Docker de la API (factor 5: build/release/run).
# Debe coincidir con APP_VERSION en cada release; nunca usar "latest" como release real.
IMAGE_TAG=2.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000
# Procesos de uvicorn. 1 para desarrollo; en Docker, tantos como nucleos quieras dedicar.
WEB_CONCURRENCY=1
# Segundos que uvicorn mantiene una conexion inactiva: mas que Traefik (90 s).
HTTP_KEEP_ALIVE_SECONDS=120

# Extraccion. El servicio no usa base de datos: guardar documentos es trabajo
# de document-store, a traves del orquestador (ADR-0008).
MAX_PDF_SIZE_BYTES=10485760
# Backpressure de POST /extract: tiempo util de un request (espera + extraccion);
# si no llega a terminar a tiempo, 503 sin procesarlo. Menor que el timeout de los clientes.
EXTRACT_MAX_WAIT_SECONDS=25
# Requests de /extract admitidos a la vez por proceso (la cola); llena, 503.
EXTRACT_MAX_PENDING=60
# Orden de la cola: size (primero el PDF mas liviano; con un nucleo por replica)
# o fifo (por llegada; si la maquina tiene menos nucleos que replicas).
EXTRACT_QUEUE_ORDER=size
# Con size, el request que ya espero estos segundos pasa primero.
EXTRACT_PRIORITY_AGE_SECONDS=7.5
# Origenes permitidos por CORS, separados por coma. "*" = cualquiera, sin credenciales.
CORS_ALLOW_ORIGINS=*

# API Settings
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json
