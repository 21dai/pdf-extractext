# Application Settings
APP_NAME=PDF Extract API
APP_VERSION=1.3.0
DEBUG=False
# Nivel de los logs JSON en stdout: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Tag inmutable de la imagen Docker de la API (factor 5: build/release/run).
# Debe coincidir con APP_VERSION en cada release; nunca usar "latest" como release real.
IMAGE_TAG=1.3.0

# Server Settings
HOST=0.0.0.0
PORT=8000
# Procesos de uvicorn. 1 para desarrollo; en Docker, tantos como nucleos quieras dedicar.
WEB_CONCURRENCY=1

# Database Settings
# Usa "mongo" como host si la API corre dentro del stack Docker (docker-compose.yml).
# Usa "localhost" si corres la API fuera de Docker contra el Mongo expuesto por docker-compose.db.yml.
DATABASE_URL=mongodb://admin:9009@mongo:27017/?authSource=admin
DATABASE_NAME=pdf_extract
DATABASE_TIMEOUT_MS=3000
MAX_PDF_SIZE_BYTES=10485760
# false: el servicio solo expone POST /extract y no usa MongoDB (replicas del TP).
DOCUMENTS_API_ENABLED=true
# Backpressure de POST /extract: espera estimada maxima para admitir un request;
# por encima responde 503 con Retry-After. Menor que el timeout de los clientes.
EXTRACT_MAX_WAIT_SECONDS=28
# Requests de /extract admitidos a la vez por proceso (la cola); llena, 503.
EXTRACT_MAX_PENDING=30

# API Settings
API_V1_PREFIX=/api/v1
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json

# MongoDB Docker Credentials
ROOT_USERNAME=admin
ROOT_PASSWORD=9009
