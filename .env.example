# Application Settings
APP_NAME=PDF Extract API
APP_VERSION=1.0.0
DEBUG=False

# Tag inmutable de la imagen Docker de la API (factor 5: build/release/run).
# Debe coincidir con APP_VERSION en cada release; nunca usar "latest" como release real.
IMAGE_TAG=1.0.0

# Server Settings
HOST=0.0.0.0
PORT=8000

# Database Settings
# Usa "mongo" como host si la API corre dentro del stack Docker (docker-compose.yml).
# Usa "localhost" si corres la API fuera de Docker contra el Mongo expuesto por docker-compose.db.yml.
DATABASE_URL=mongodb://admin:9009@mongo:27017/?authSource=admin
DATABASE_NAME=pdf_extract
DATABASE_TIMEOUT_MS=3000
MAX_PDF_SIZE_BYTES=10485760

# API Settings
API_V1_PREFIX=/api/v1
API_DOCS_URL=/docs
API_REDOC_URL=/redoc
API_OPENAPI_URL=/openapi.json

# MongoDB Docker Credentials
ROOT_USERNAME=admin
ROOT_PASSWORD=9009
